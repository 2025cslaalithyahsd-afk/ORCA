# ORCA Environment Configuration
# Dual Reasoning Mode:
# If GEMINI_API_KEY or OPENAI_API_KEY is provided, ORCA leverages LLM enrichment.
# Otherwise, ORCA operates seamlessly with the built-in deterministic heuristic rule engine.

PORT=8000
DATABASE_URL=sqlite:///./orca_marine.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional LLM Keys (Leave blank to use robust local deterministic agent engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
